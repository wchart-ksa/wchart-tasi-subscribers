# ============================================================
# متغيرات البيئة — انسخ هذا الملف إلى .env ثم عدّل القيم
# لا ترفع ملف .env إلى المستودع أو إلى مجلد عام على الاستضافة
# ============================================================

# مفتاح توقيع الجلسات: ولّد قيمة عشوائية طويلة (مثلاً: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-long-random-secret

# production = كوكيز Secure (HTTPS) | development = تشغيل محلي بدون HTTPS
ENV=production

# إعدادات خادم التطوير (عبر python app.py) — غيّر المنفذ إن كان مشغولاً
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=true

# مسار ملف قاعدة البيانات (نسبية إلى مجلد المشروع) — لا ضعه داخل static
DATA_FILE=subscribers_1.xlsx

# مجلد النسخ الاحتياطية اليومية
BACKUP_DIR=backups

# ملف تقرير التفعيل المُشتق (رقم الجوال + حالة التفعيل) — يُبنى تلقائياً
ACTIVATION_REPORT_FILE=activated_subscribers.xlsx

# إرسال البريد عبر Gmail SMTP (كلمة مرور التطبيق App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=wchart.ksa@gmail.com
SMTP_PASSWORD=ضع-كلمة-مرور-التطبيق-هنا
MAIL_FROM=wchart.ksa@gmail.com
MAIL_REPLY_TO=wchart.ksa@gmail.com

# مدة صلاحية جلسة الدخول بالأيام
SESSION_DAYS=7

# مدة اشتراك العضو الجديد بال أيام
ACTIVATION_DAYS=30
